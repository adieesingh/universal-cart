generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  items        CartItem[]
}

model CartItem {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  canonicalUrl  String
  store         String
  title         String?
  image         String?
  price         Float?
  currency      String?
  quantity      Int            @default(1)
  lastCheckedAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  history       PriceHistory[]

  @@unique([userId, canonicalUrl])
  @@index([userId, store])
}

model PriceHistory {
  id        String   @id @default(cuid())
  itemId    String
  item      CartItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price     Float
  checkedAt DateTime @default(now())

  @@index([itemId, checkedAt])
}
